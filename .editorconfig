root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_size = 2

# JUCE's sources have CRLF line endings, so the hunks of our patches to them do too.
[cmake/patches/juce-*.patch]
end_of_line = unset
trim_trailing_whitespace = false
