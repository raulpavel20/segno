# ADR 0021: MCP lives only in the DAW. Nothing in libs/, devices/, modules/, plugins/ or tools/
# includes or links the MCP code (so the plugins never contain it).
# Run as: cmake -DROOT=<project source dir> -P CheckMcpBoundary.cmake
set(failed "")
foreach(dir libs devices modules plugins tools)
    file(GLOB_RECURSE sources "${ROOT}/${dir}/*.h" "${ROOT}/${dir}/*.hpp" "${ROOT}/${dir}/*.cpp")
    foreach(f IN LISTS sources)
        file(READ "${f}" content)
        if(content MATCHES "#include [<\"](app/src/)?mcp/")
            list(APPEND failed "${f} includes the MCP code")
        endif()
    endforeach()
    file(GLOB_RECURSE lists "${ROOT}/${dir}/CMakeLists.txt" "${ROOT}/${dir}/*.cmake")
    foreach(f IN LISTS lists)
        file(READ "${f}" content)
        if(content MATCHES "fd_mcp|fd_app_mcp|fd_dep_httplib")
            list(APPEND failed "${f} links the MCP code")
        endif()
    endforeach()
endforeach()
if(failed)
    string(REPLACE ";" "\n  " failed "${failed}")
    message(FATAL_ERROR "MCP must stay in the DAW (ADR 0021):\n  ${failed}")
endif()
