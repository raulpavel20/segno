     /** Segno: with ProcessingPosition::beforePlugin, the plugin this Modifier is processed before. */
     virtual EditItemID getPluginToProcessBefore()               { return {}; }
 
+    /** Segno: a track this Modifier also hears (with ProcessingPosition::beforePlugin): its sound
+        after its plugins comes in on two channels after the track's own two, as a plugin's
+        sidechain does, and only the track's own go on. None by default. */
+    virtual EditItemID getSidechainSourceID() const             { return {}; }
+
     //==============================================================================
     /** Sub classes should implement this to initialise the Modifier. */
     virtual void initialise (double /*sampleRate*/, int /*blockSizeSamples*/) {}
