 /**
+    Passes its input on as it is, and is summed as it is: a SummingNode leaves it out of its
+    latency compensation, so it isn't delayed to line up with the other inputs and its own
+    latency doesn't delay them (a monitored track heard sooner).
+*/
+class UncompensatedNode final : public Node
+{
+public:
+    UncompensatedNode (std::unique_ptr<Node> inputNode)
+        : input (std::move (inputNode))
+    {
+        jassert (input);
+        setOptimisations ({ ClearBuffers::no, AllocateAudioBuffer::yes });
+    }
+
+    NodeProperties getNodeProperties() override
+    {
+        constexpr size_t uncompensatedNodeMagicHash = size_t (0x95ab5e9dce);
+        auto props = input->getNodeProperties();
+
+        if (props.nodeID != 0)
+            hash_combine (props.nodeID, uncompensatedNodeMagicHash);
+
+        return props;
+    }
+
+    std::vector<Node*> getDirectInputNodes() override
+    {
+        return { input.get() };
+    }
+
+    bool isReadyToProcess() override
+    {
+        return input->hasProcessed();
+    }
+
+    void process (ProcessContext& pc) override
+    {
+        auto inputBuffers = input->getProcessedOutput();
+        copy (pc.buffers.audio, inputBuffers.audio);
+        pc.buffers.midi.copyFrom (inputBuffers.midi);
+    }
+
+private:
+    std::unique_ptr<Node> input;
+};
+
