+// Segno: the modifiers of a list to process just before a plugin (ProcessingPosition::beforePlugin),
+// in the list's order. With no plugin, those whose plugin isn't in the chain; with no chain either
+// (its plugins left out of the graph), all of them.
+static std::unique_ptr<tracktion::graph::Node> createModifierNodesBefore (ModifierList* list, Plugin* plugin, PluginList* chain,
+                                                                          const TrackMuteState* trackMuteState,
+                                                                          std::unique_ptr<Node> node,
+                                                                          tracktion::graph::PlayHeadState& playHeadState,
+                                                                          const CreateNodeParams& params)
+{
+    if (list == nullptr)
+        return node;
+
+    for (auto& modifier : list->getModifiers())
+    {
+        if (modifier->getProcessingPosition() != Modifier::ProcessingPosition::beforePlugin)
+            continue;
+
+        const auto before = modifier->getPluginToProcessBefore();
+        const bool here = plugin != nullptr ? before == plugin->itemID
+                        : chain != nullptr  ? ! std::any_of (chain->begin(), chain->end(),
+                                                             [&] (auto* p) { return p->itemID == before; })
+                                            : true;
+        if (! here)
+            continue;
+
+        node = makeNode<ModifierNode> (std::move (node), modifier, params.sampleRate, params.blockSize,
+                                       trackMuteState, playHeadState, params.forRendering,
+                                       ModifierNode::ClearOutputs::no);
+    }
+
+    return node;
+}
