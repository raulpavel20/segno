+TimeDuration AudioClipBase::getTail() const
+{
+    return (araProxy != nullptr ? araProxy->getTail() : TimeDuration())
+           + edit.engine.getEngineBehaviour().getAudioClipExtension (*const_cast<AudioClipBase*> (this)).end;
+}
 
