+++ b/modules/tracktion_engine/playback/graph/tracktion_EditNodeBuilder.cpp	2026-10-15 18:55:43.101667219 +0300
@@ -84,8 +84,8 @@
             if (p->getSidechainSourceID() == itemID)
                 return true;
 
-        // Segno: a modifier that hears it (Modifier::getSidechainSourceID).
-        for (auto at : getAudioTracks (t.edit))
+        // Segno: a modifier that hears it (Modifier::getSidechainSourceID), the master's too.
+        for (auto at : getAllTracks (t.edit))
             if (auto list = at->getModifierList())
                 for (auto& m : list->getModifiers())
                     if (m->getSidechainSourceID() == itemID)
@@ -2028,7 +2028,10 @@
     node = createModifierNodeForList (masterModList, Modifier::ProcessingPosition::preFX,
