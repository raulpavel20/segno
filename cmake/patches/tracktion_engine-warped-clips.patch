+++ b/modules/tracktion_engine/model/clips/tracktion_AudioClipBase.cpp	2026-10-15 17:56:08.587644676 +0300
@@ -666,6 +666,11 @@
 {
     TimeStretcher::Mode ts = timeStretchMode;
 
+    // A clip can ask to follow the tempo by resampling, speed and pitch together, rather than
+    // stretching (the host's "resample" property): with no transposition to stretch for.
+    if (ts == TimeStretcher::disabled && state.getProperty ("resample", false) && ! getAutoPitch() && getPitchChange() == 0.0f)
+        return ts;
+
     if (ts == TimeStretcher::disabled && (getAutoPitch() || getAutoTempo() || getPitchChange() != 0.0f))
         ts = TimeStretcher::defaultMode;
 
