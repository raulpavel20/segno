+/** Decides, as a MIDI clip plays, which of its events play and how (Segno: notes left to chance,
+    rolled again each pass; @see EngineBehaviour::createMidiPlaybackFilter). Events are named by
+    their index in the sequence the clip's node plays. Called on the audio thread: no allocation,
+    no locks.
+*/
+struct MidiPlaybackFilter
+{
+    virtual ~MidiPlaybackFilter() = default;
+
+    /** A block starts at `editTime` (in the node's time base) while the transport is or isn't
+        playing; called before the block's events. */
+    virtual void startBlock (double /*editTime*/, bool /*isPlaying*/) noexcept {}
+
+    /** Event `index`: false leaves it out (a note-on, its note-off too); it may change the
+        message (a note-on's velocity). Chased notes, sent again when playback starts inside
+        them, come here as well. */
+    virtual bool shouldPlay (int index, juce::MidiMessage&) noexcept = 0;
+
+    /** Whether note-on `index` plays this time round, as last decided (no change made). */
+    virtual bool plays (int /*index*/) const noexcept { return true; }
+};
+
