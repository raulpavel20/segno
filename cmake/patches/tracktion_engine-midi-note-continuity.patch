+void MidiNode::addNotesPlayingAt (TimePosition time, BeatPosition beat, ActiveNoteList& out) const noexcept
+{
+    if (shouldCreateMessagesForTime || ms.empty() || clipLevel.isMute() || (shouldBeMutedDelegate && shouldBeMutedDelegate()))
+        return;
+
+    const auto now = timeBase == MidiList::TimeBase::beats ? beat.inBeats() : time.inSeconds();
+
+    if (now < editRange.getStart() || now >= editRange.getEnd())
+        return;
+
+    const auto local = now - editRange.getStart();
+    const auto& sequence = ms[currentSequence];
+
+    for (int i = 0; i < sequence.getNumEvents(); ++i)
+    {
+        const auto* meh = sequence.getEventPointer (i);
+
+        if (meh->message.getTimeStamp() > local)
+            break;
+
+        if (meh->message.isNoteOn() && meh->noteOffObject != nullptr
+            && meh->noteOffObject->message.getTimeStamp() > local)
+            out.startNote (meh->message.getChannel(), meh->message.getNoteNumber());
+    }
+}
