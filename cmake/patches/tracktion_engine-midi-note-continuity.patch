+void CombiningNode::followNotes (const MidiMessageArray& midi) noexcept
+{
+    for (const auto& m : midi)
+    {
+        if (m.isNoteOn())
+            notesOn->startNote (m.getChannel(), m.getNoteNumber());
+        else if (m.isNoteOff())
+            notesOn->clearNote (m.getChannel(), m.getNoteNumber());
+        else if (m.isAllNotesOff() || m.isAllSoundOff())
+            for (int note = 0; note < 128; ++note)
+                notesOn->clearNote (m.getChannel(), note);
+    }
+}
+
+void CombiningNode::endNotes (MidiMessageArray& dest, const ActiveNoteList& stillPlayed) noexcept
+{
+    notesOn->iterate ([&] (int channel, int note)
+                      {
+                          if (stillPlayed.isNoteActive (channel, note))
+                              return;
+
+                          dest.addMidiMessage (juce::MidiMessage::noteOff (channel, note), 0.0, noteOffSourceID);
+                          notesOn->clearNote (channel, note);
+                      });
+}
+
+void CombiningNode::endNotesNoLongerPlayed (MidiMessageArray& dest) noexcept
+{
+    if (! notesOn->areAnyNotesActive())
+        return;
+
+    // What the clips play at the playhead now. A clip about to chase its notes (new, or after a
+    // loop wrap) counts for nothing: its note-ons come just after these note-offs.
+    ActiveNoteList played;
+
+    if (getPlayHead().isPlaying() && getPlayHeadState().isContiguousWithPreviousBlock())
+    {
+        const auto time = getEditTimeRange().getStart();
+        const auto beat = getEditBeatRange().getStart();
+
+        if (auto g = groups[combining_node_utils::timeToGroupIndex (time)])
+        {
+            for (auto tan : *g)
+            {
+                for (auto n : tan->nodes())
+                {
+                    if (auto midiNode = dynamic_cast<MidiNode*> (n))
+                        midiNode->addNotesPlayingAt (time, beat, played);
+                    else if (auto loopingMidiNode = dynamic_cast<LoopingMidiNode*> (n))
+                        loopingMidiNode->getActiveNoteList()->iterate ([&] (int c, int k) { played.startNote (c, k); });
+                }
+            }
+        }
+    }
+
+    endNotes (dest, played);
+}
