# Device registration.
#
#   fd_add_device(ID utility DSP_SOURCES dsp/Utility.cpp)
#       Creates the JUCE-free target fd_device_<cid>_dsp (cid = ID with '-' -> '_')
#       and registers the device for the generated registry. The device must define
#       `const fd::DeviceFactory& fd::devices::<camel>Factory()`, where camel is the ID in
#       camelCase (subtractive-synth -> subtractiveSynthFactory).
#
#   fd_generate_device_registry()
#       Called once after all devices are added. Creates fd::registry, which links every
#       device's DSP and implements fd::allDevices().

# kebab-case -> camelCase ("subtractive-synth" -> "subtractiveSynth").
function(fd_camel_case input outVar)
    string(REPLACE "-" ";" parts "${input}")
    set(result "")
    foreach(part IN LISTS parts)
        if(result STREQUAL "")
            set(result "${part}")
        else()
            string(SUBSTRING "${part}" 0 1 first)
            string(SUBSTRING "${part}" 1 -1 rest)
            string(TOUPPER "${first}" first)
            string(APPEND result "${first}${rest}")
        endif()
    endforeach()
    set(${outVar} "${result}" PARENT_SCOPE)
endfunction()

function(fd_add_device)
    cmake_parse_arguments(ARG "" "ID" "DSP_SOURCES" ${ARGN})
    if(NOT ARG_ID OR NOT ARG_DSP_SOURCES)
        message(FATAL_ERROR "fd_add_device: ID and DSP_SOURCES are required")
    endif()
    string(REPLACE "-" "_" cid "${ARG_ID}")
    set(target fd_device_${cid}_dsp)

    add_library(${target} STATIC ${ARG_DSP_SOURCES})
    target_include_directories(${target} PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/dsp")
    target_link_libraries(${target} PUBLIC fd::device fd::dsp PRIVATE fd::warnings)

    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/SPEC.md")
        set_property(GLOBAL APPEND PROPERTY FD_DEVICE_IDS "${ARG_ID}")
    else()
        message(FATAL_ERROR "Device '${ARG_ID}' has no SPEC.md (see docs/devices/SPEC-TEMPLATE.md)")
    endif()
endfunction()

function(fd_generate_device_registry)
    get_property(ids GLOBAL PROPERTY FD_DEVICE_IDS)
    set(decls "")
    set(entries "")
    set(libs "")
    foreach(id IN LISTS ids)
        string(REPLACE "-" "_" cid "${id}")
        fd_camel_case("${id}" camel)
        string(APPEND decls "const DeviceFactory& ${camel}Factory();\n")
        string(APPEND entries "        &devices::${camel}Factory(),\n")
        list(APPEND libs fd_device_${cid}_dsp)
    endforeach()

    set(out "${CMAKE_BINARY_DIR}/generated/fd_registry.cpp")
    file(CONFIGURE OUTPUT "${out}" CONTENT [[
// Generated by cmake/FdAddDevice.cmake. Do not edit.
#include <fd/device/Registry.h>

namespace fd
{
namespace devices
{
@decls@}

std::span<const DeviceFactory* const> allDevices()
{
    static const DeviceFactory* const list[] = {
@entries@    };
    return list;
}
} // namespace fd
]] @ONLY)

    add_library(fd_registry STATIC "${out}")
    add_library(fd::registry ALIAS fd_registry)
    target_link_libraries(fd_registry PUBLIC fd::device ${libs})
    list(LENGTH ids n)
    message(STATUS "foss-daw: ${n} device(s) registered: ${ids}")
endfunction()

# ---------------------------------------------------------------------------
# Device UI (JUCE line). Device UIs are INTERFACE libraries whose sources compile inside each
# consumer (plugin, app, tools), like JUCE modules, so JUCE configuration stays consistent.
#
#   fd_add_device_ui(ID utility SOURCES ui/UtilityPanel.cpp)
#       The device must define `const fd::ui::PanelFactory& fd::devices::<camel>PanelFactory()`.
#
#   fd_generate_panel_registry()
#       Creates fd_panel_registry (INTERFACE), which implements fd::ui::allPanels().
# ---------------------------------------------------------------------------
function(fd_add_device_ui)
    if(NOT FD_NEEDS_JUCE)
        return()
    endif()
    cmake_parse_arguments(ARG "" "ID" "SOURCES" ${ARGN})
    string(REPLACE "-" "_" cid "${ARG_ID}")
    set(target fd_device_${cid}_ui)
    list(TRANSFORM ARG_SOURCES PREPEND "${CMAKE_CURRENT_SOURCE_DIR}/")
    add_library(${target} INTERFACE)
    target_sources(${target} INTERFACE ${ARG_SOURCES})
    target_include_directories(${target} INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/ui")
    target_link_libraries(${target} INTERFACE fd::fd_device_ui fd_device_${cid}_dsp)
    set_property(GLOBAL APPEND PROPERTY FD_DEVICE_UI_IDS "${ARG_ID}")
endfunction()

function(fd_generate_panel_registry)
    get_property(ids GLOBAL PROPERTY FD_DEVICE_UI_IDS)
    set(decls "")
    set(entries "")
    set(libs "")
    foreach(id IN LISTS ids)
        string(REPLACE "-" "_" cid "${id}")
        fd_camel_case("${id}" camel)
        string(APPEND decls "const ui::PanelFactory& ${camel}PanelFactory();\n")
        string(APPEND entries "        &devices::${camel}PanelFactory(),\n")
        list(APPEND libs fd_device_${cid}_ui)
    endforeach()

    set(out "${CMAKE_BINARY_DIR}/generated/fd_panel_registry.cpp")
    file(CONFIGURE OUTPUT "${out}" CONTENT [[
// Generated by cmake/FdAddDevice.cmake. Do not edit.
#include <fd_device_ui/fd_device_ui.h>

namespace fd
{
namespace devices
{
@decls@}

std::span<const ui::PanelFactory* const> ui::allPanels()
{
    static const PanelFactory* const list[] = {
@entries@    };
    return list;
}
} // namespace fd
]] @ONLY)

    add_library(fd_panel_registry INTERFACE)
    target_sources(fd_panel_registry INTERFACE "${out}")
    target_link_libraries(fd_panel_registry INTERFACE fd::fd_device_ui ${libs})
endfunction()
