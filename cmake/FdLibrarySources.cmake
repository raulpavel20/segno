# The Library's sources (ADR 0055, docs/design/factory-library.md §6): every file
# tools/library/recipe.json names, fetched from its repository at the commit the recipe pins and
# checked by its SHA-256, into SOURCES/<source>/<commit>/<path>. Files already there and right are
# left alone, so it runs once; the first time it fetches about 2 GB.
#
#   cmake -DRECIPE=<recipe.json> -DSOURCES=<cache> -P FdLibrarySources.cmake

file(READ "${RECIPE}" recipe)
string(JSON sourceCount LENGTH "${recipe}" sources)
math(EXPR lastSource "${sourceCount} - 1")
foreach(s RANGE ${lastSource})
    string(JSON id MEMBER "${recipe}" sources ${s})
    string(JSON commit GET "${recipe}" sources ${id} commit)
    string(JSON raw GET "${recipe}" sources ${id} raw)
    set(commit_${id} "${commit}")
    set(raw_${id} "${raw}")
endforeach()

string(JSON instrumentCount LENGTH "${recipe}" instruments)
math(EXPR lastInstrument "${instrumentCount} - 1")
set(fetched 0)
set(checked 0)
foreach(i RANGE ${lastInstrument})
    string(JSON source GET "${recipe}" instruments ${i} source)
    string(JSON sfz GET "${recipe}" instruments ${i} sfz)
    string(JSON zoneCount LENGTH "${recipe}" instruments ${i} zones)
    math(EXPR lastZone "${zoneCount} - 1")
    foreach(z RANGE ${lastZone})
        string(JSON file GET "${recipe}" instruments ${i} zones ${z} file)
        string(JSON hash GET "${recipe}" instruments ${i} zones ${z} sha256)
        set(local "${SOURCES}/${source}/${commit_${source}}/${file}")
        if(EXISTS "${local}")
            file(SHA256 "${local}" have)
            if(have STREQUAL hash)
                math(EXPR checked "${checked} + 1")
                continue()
            endif()
        endif()
        # The path in a URL: the characters these libraries' names use, escaped.
        string(REPLACE "%" "%25" url "${file}")
        string(REPLACE " " "%20" url "${url}")
        string(REPLACE "#" "%23" url "${url}")
        string(REPLACE "&" "%26" url "${url}")
        string(REPLACE "+" "%2B" url "${url}")
        string(REPLACE "?" "%3F" url "${url}")
        string(REPLACE "," "%2C" url "${url}")
        file(DOWNLOAD "${raw_${source}}/${commit_${source}}/${url}" "${local}" EXPECTED_HASH SHA256=${hash}
             TLS_VERIFY ON STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Couldn't fetch ${file} (${sfz}): ${status}")
        endif()
        math(EXPR fetched "${fetched} + 1")
        if(fetched EQUAL 1 OR fetched MATCHES "00$")
            message(STATUS "The Library's sources: ${fetched} fetched")
        endif()
    endforeach()
endforeach()
message(STATUS "The Library's sources: ${fetched} fetched, ${checked} already here")
