# fd_generate_module_purposes(<output header>)
#   Each module's "## Purpose" paragraph from devices/<id>/SPEC.md, as C++ string constants, for
#   the MCP module reference (docs/design/mcp.md §4). Regenerated whenever a SPEC changes.
function(fd_generate_module_purposes output)
    file(GLOB specs "${PROJECT_SOURCE_DIR}/devices/*/SPEC.md")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${specs})
    set(entries "")
    foreach(spec IN LISTS specs)
        get_filename_component(dir "${spec}" DIRECTORY)
        get_filename_component(id "${dir}" NAME)
        file(READ "${spec}" text)
        string(FIND "${text}" "## Purpose\n" start)
        if(start EQUAL -1)
            continue()
        endif()
        math(EXPR start "${start} + 11")
        string(SUBSTRING "${text}" ${start} -1 rest)
        string(FIND "${rest}" "\n## " end)
        string(SUBSTRING "${rest}" 0 ${end} purpose)
        string(STRIP "${purpose}" purpose)
        string(APPEND entries "    {\"${id}\", R\"fdspec(${purpose})fdspec\"},\n")
    endforeach()
    set(content "// Generated by cmake/ModulePurposes.cmake from devices/*/SPEC.md. Do not edit.\n#pragma once\n\n#include <string_view>\n\nnamespace fd::mcp\n{\nstruct ModulePurpose\n{\n    std::string_view id;\n    std::string_view text;\n};\n\ninline constexpr ModulePurpose modulePurposes[] = {\n${entries}};\n} // namespace fd::mcp\n")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${content}" @ONLY)
endfunction()
